# Salin jadi .env lalu isi. Jangan upload .env ke GitHub.
PORT=3000
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
# Set 1 jika di belakang proxy/hosting (agar IP asli terbaca untuk rate limit)
TRUST_PROXY=0
# Domain frontend yang boleh memanggil API (jika frontend di Netlify), pisahkan dengan koma
ALLOWED_ORIGINS=https://amprem-generator-vell-dua.netlify.app
